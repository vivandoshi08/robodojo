# Extra settings for QM's dev instance (merged into ~/.config/qm/dev.env, or point QM_DEV_ENV here).
# Copy to qm/dev.env (gitignored) and fill in the key.

ANTHROPIC_API_KEY=sk-ant-...

# Every scope / swarm worker gets its own container from our image (MuJoCo + robodojo baked in).
SANDBOX_BACKEND=local
LOCAL_SANDBOX_IMAGE=robodojo-qm-sandbox:latest
LOCAL_SANDBOX_CPUS=2
LOCAL_SANDBOX_MEMORY_MB=3072

# Swarms (one worker per strategy) need durable stores + sandbox inventory.
SESSION_STORE=postgres
RUN_STORE=postgres
SANDBOX_RESOURCES_ENABLED=true
SWARM_DEFAULTS={"agents":6,"turnMs":900000}
